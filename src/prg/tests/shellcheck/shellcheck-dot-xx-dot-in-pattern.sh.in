#! @envlocation@ bash
#########################################################################
#									#
#	script shellcheck-dot-xx-dot-in-pattern.sh is automatically	#
#	generated, please do not modify!				#
#									#
#########################################################################

#########################################################################
#									#
# Author: Copyright (C) 2026  Mark Grant				#
#									#
# Released under the GPLv3 only.					#
# SPDX-License-Identifier: GPL-3.0-only					#
#									#
# Purpose:								#
# Script which runs shellcheck on:-					#
#		foo or foo.$1 in the build tree which has been		#
#			generated from foo.$1.in in the source tree.	#
#									#
# Syntax:	shellcheck-dot-xx-dot-in-pattern.sh sh			#
#									#
# Exit codes used:-							#
# Bash standard Exit Codes:	0 - success				#
#				1 - general failure			#
# User-defined exit code range is 64 - 113				#
#	C/C++ Semi-standard exit codes from sysexits.h range is 64 - 78	#
#		EX_USAGE	64	command line usage error	#
#		EX_DATAERR	65	data format error		#
#		EX_NOINPUT	66	cannot open input		#
#		EX_NOUSER	67	addressee unknown		#
#		EX_NOHOST	68	host name unknown		#
#		EX_UNAVAILABLE	69	service unavailable		#
#		EX_SOFTWARE	70	internal software error		#
#		EX_OSERR	71	system error (e.g., can't fork)	#
#		EX_OSFILE	72	critical OS file missing	#
#		EX_CANTCREAT	73	can't create (user) output file	#
#		EX_IOERR	74	input/output error		#
#		EX_TEMPFAIL	75	temp failure; user is invited	#
#					to retry			#
#		EX_PROTOCOL	76	remote error in protocol	#
#		EX_NOPERM	77	permission denied		#
#		EX_CONFIG	78	configuration error		#
#	User-defined (here) exit codes range 79 - 113:			#
#		None							#
#									#
# Further Info:								#
#									#
#########################################################################


set -euo pipefail

cd "$(dirname "$0")"


##################
# Init variables #
##################
# shellcheck disable=SC2034		# Unused variable left, possibly useful
readonly version=1.0.1			# set version variable
# shellcheck disable=SC2034		# Unused variable left, possibly useful
readonly packageversion=@pkgversion@	# Version of the complete package

readonly base_ext="$1"			# sh or at etc


#############
# Functions #
#############

# Standard function to emit messages depending on various parameters.
# Parameters -	$1 What:-	The message to emit.
#		$2 Where:-	stdout == 0
#				stderr == 1
# No return value.
output()
{
	if (( !$2 )); then
		printf "%s\n" "$1"
	else
		printf "%s\n" "$1" 1>&2
	fi
}

# Standard function to tidy up and return exit code.
# Parameters - 	$1 is the exit code.
# No return value.
script_exit()
{
	exit "$1"
}

# Standard trap exit function.
# No parameters.
# No return value.
# Do not warn about unreachable commands in trap functions, nor function is
# never invoked as these are legitimate features of trap handlers.
# shellcheck disable=SC2317,SC2329
trap_exit()
{
	local exit_code=$?
	local msg

	msg="Script terminating with exit code $exit_code due to trap received."
	output "$msg" 1 0
	script_exit "$exit_code"
}

# Setup trap.
trap trap_exit SIGHUP SIGINT SIGQUIT SIGTERM


########
# Main #
########

# For each file like path/to/foo.$1.in in the source tree, look in the build
# tree for:-
#	buildrootdir/path/to/foo (basename match, no extension)
# and
#	buildrootdir/path/to/foo.$1 (basename match with .$1)
#
# We want this command to operate without expansion
# shellcheck disable=SC2016
mapfile -t targets < <(
	find @abstopsrcdir@ -type f -name '*.'"$base_ext"'.in' -print0 |
		xargs -0 -I{} bash -c '
	filepath="$1"
	base_ext1="$2"
	# strip abstopsrcdir gives path/to/foo.$1.in
	relfilepath1="${filepath#@abstopsrcdir@/}"
	# strip .$1.in gives path/to/foo
	relfilepath2="${relfilepath1%.$base_ext1.in}"
	# produce abstopbuilddir/path/to/foo
	targetfilepath1="@abstopbuilddir@/$relfilepath2"
	# produce abstopbuilddir/path/to/foo.$1
	targetfilepath2="@abstopbuilddir@/$relfilepath2.$base_ext1"
	if [ -f "$targetfilepath1" ]; then echo "$targetfilepath1"; fi
	if [ -f "$targetfilepath2" ]; then echo "$targetfilepath2"; fi
	' _ {} "$base_ext"
	)

if [ "${#targets[@]}" -eq 0 ]; then
	output "No scripts found." "0"
	script_exit 0
fi

shellcheck -ax "${targets[@]}"

printf '%s\n' "${targets[@]}" | sort

output "Files processed - ${#targets[@]}" "0"

cd -

script_exit "0"

